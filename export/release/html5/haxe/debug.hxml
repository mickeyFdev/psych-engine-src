-main ApplicationMain 
-cp C:/HaxeToolkit/haxe/lib/flixel/5,6,1
-D flixel=5.6.1
--macro openfl.utils._internal.ExtraParamsMacro.include()
-cp C:/HaxeToolkit/haxe/lib/openfl/9,5,2/src
-D openfl=9.5.2
--macro lime._internal.macros.DefineMacro.run()
--macro haxe.macro.Compiler.addMetadata("@:autoBuild(lime._internal.macros.AssetsMacro.embedBytes())", "haxe.io.Bytes")
-cp C:/HaxeToolkit/haxe/lib/lime/8,3,2/src
-D lime=8.3.2
-cp C:/HaxeToolkit/haxe/lib/flixel-addons/3,2,2
-D flixel-addons=3.2.2
-cp C:/HaxeToolkit/haxe/lib/tjson/1,4,0
-D tjson=1.4.0
-cp C:/HaxeToolkit/haxe/lib/flxanimate/git
-D flxanimate=4.0.0
-cp source
-D SHOW_LOADING_SCREEN
-D PSYCH_WATERMARKS
-D message.reporting=pretty
-D howlerjs
-D MULTITHREADED_LOADING
-D lime-webgl
-D lime-dom
-D lime-howlerjs
-D lime-html5
-D lime-threads
-D FLX_NO_FOCUS_LOST_SCREEN
-D tools=8.3.2
-D lime-canvas
-D FLX_NO_DEBUG
-D no-deprecation-warnings
-D ACHIEVEMENTS_ALLOWED
-D no-compilation
-D openfl-html5
-D NAPE_RELEASE_BUILD
-D LINC_LUA_RELATIVE_DYNAMIC_LIB
-D TRANSLATIONS_ALLOWED
-D IRIS_DEBUG
-D html5
-D web
--remap flash:openfl
--macro flixel.system.macros.FlxDefines.run()
--macro allowPackage('flash')
--macro include('my.pack')
-js export/release/html5/bin/PsychEngine.js
-cp export/release/html5/haxe
-D html5
-debug